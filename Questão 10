import React, { useState } from "react";
import {
  View,
  Text,
  Image,
  FlatList,
  Pressable,
  StyleSheet,
  SafeAreaView,
  useColorScheme,
} from "react-native";

const POSTS = Array.from({ length: 18 }).map((_, i) => ({ id: String(i) }));

export default function App() {
  const [following, setFollowing] = useState(false);
  const isDark = useColorScheme() === "dark";

  const theme = {
    bg: isDark ? "#121212" : "#ffffff",
    card: isDark ? "#1e1e1e" : "#ffffff",
    text: isDark ? "#ffffff" : "#000000",
    gray: isDark ? "#aaaaaa" : "#666666",
    border: isDark ? "#333333" : "#eeeeee",
    accent: "#007bff",
  };

  const Header = () => (
    <View
      style={[
        styles.header,
        { backgroundColor: theme.card, borderBottomColor: theme.border },
      ]}
    >
      <Image
        source={{
          uri: "https://upload.wikimedia.org/wikipedia/commons/e/e1/FullMoon2010.jpg",
        }}
        style={styles.avatar}
      />
      <Text style={[styles.name, { color: theme.text }]}>Luis Felipe</Text>
      <Text style={[styles.bio, { color: theme.gray }]}>
        Entusiasta de FUNK
      </Text>

      <View style={styles.stats}>
        <View style={styles.statBox}>
          <Text style={[styles.statNum, { color: theme.text }]}>18</Text>
          <Text style={[styles.statLabel, { color: theme.gray }]}>Posts</Text>
        </View>
        <View style={styles.statBox}>
          <Text style={[styles.statNum, { color: theme.text }]}>
            {following ? "1.501" : "1.500"}
          </Text>
          <Text style={[styles.statLabel, { color: theme.gray }]}>
            Seguidores
          </Text>
        </View>
        <View style={styles.statBox}>
          <Text style={[styles.statNum, { color: theme.text }]}>400</Text>
          <Text style={[styles.statLabel, { color: theme.gray }]}>
            Seguindo
          </Text>
        </View>
      </View>

      <Pressable
        onPress={() => setFollowing(!following)}
        style={({ pressed }) => [
          styles.btn,
          {
            backgroundColor: following ? "transparent" : theme.accent,
            borderColor: theme.accent,
          },
          following && { borderWidth: 1 },
          pressed && { opacity: 0.7 },
        ]}
      >
        <Text
          style={[styles.btnText, { color: following ? theme.accent : "#fff" }]}
        >
          {following ? "Seguindo" : "Seguir"}
        </Text>
      </Pressable>
    </View>
  );

  return (
    <SafeAreaView style={[styles.container, { backgroundColor: theme.bg }]}>
      <FlatList
        data={POSTS}
        ListHeaderComponent={Header}
        numColumns={3}
        keyExtractor={(item) => item.id}
        renderItem={() => (
          <Pressable
            style={[
              styles.post,
              {
                backgroundColor: isDark ? "#333" : "#ddd",
                borderColor: theme.bg,
              },
            ]}
          >
            <View style={styles.postInner} />
          </Pressable>
        )}
      />
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1 },
  header: {
    alignItems: "center",
    padding: 20,
    borderBottomWidth: 1,
    elevation: 4,
    shadowColor: "#000",
    shadowOffset: { width: 0, height: 2 },
    shadowOpacity: 0.1,
    shadowRadius: 4,
  },
  avatar: { width: 100, height: 100, borderRadius: 50, marginBottom: 12 },
  name: { fontSize: 22, fontWeight: "bold" },
  bio: { fontSize: 14, marginBottom: 20 },
  stats: {
    flexDirection: "row",
    width: "100%",
    justifyContent: "space-around",
    marginBottom: 20,
  },
  statBox: { alignItems: "center" },
  statNum: { fontWeight: "bold", fontSize: 18 },
  statLabel: { fontSize: 12 },
  btn: {
    width: "80%",
    paddingVertical: 10,
    borderRadius: 8,
    alignItems: "center",
  },
  btnText: { fontWeight: "bold", fontSize: 16 },
  post: { flex: 1 / 3, aspectRatio: 1, borderWidth: 1 },
  postInner: { flex: 1 },
});
