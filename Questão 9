import React, { useRef, useEffect } from "react";
import { View, Animated, StyleSheet, Button } from "react-native";

export default function App() {
  const progress = useRef(new Animated.Value(0)).current;

  const handleAnimate = (value) => {
    Animated.timing(progress, {
      toValue: value,
      duration: 600,
      useNativeDriver: false,
    }).start();
  };

  const width = progress.interpolate({
    inputRange: [0, 100],
    outputRange: ["0%", "100%"],
  });

  const backgroundColor = progress.interpolate({
    inputRange: [0, 50, 100],
    outputRange: ["#4caf50", "#ffeb3b", "#f44336"],
  });

  return (
    <View style={styles.container}>
      <View style={styles.track}>
        <Animated.View style={[styles.bar, { width, backgroundColor }]} />
      </View>
      <View style={styles.buttons}>
        <Button title="0%" onPress={() => handleAnimate(0)} />
        <Button title="50%" onPress={() => handleAnimate(50)} />
        <Button title="100%" onPress={() => handleAnimate(100)} />
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, justifyContent: "center", padding: 20 },
  track: {
    height: 20,
    backgroundColor: "#e0e0e0",
    borderRadius: 10,
    overflow: "hidden",
  },
  bar: { height: "100%" },
  buttons: {
    flexDirection: "row",
    justifyContent: "space-around",
    marginTop: 20,
  },
});
